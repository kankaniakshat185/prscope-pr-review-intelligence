# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# There is no fallback for this — the app refuses to start without it.
JWT_SECRET=

# Database. Defaults to a local SQLite file if unset.
DATABASE_URL=postgresql://user:password@localhost:5432/prscope

# GitHub OAuth app credentials (for real "Login with GitHub").
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local development only: when true, GET /auth/github/callback?code=mock
# issues a valid session without going through GitHub OAuth at all.
# Leave unset/false everywhere else, especially in production.
ENABLE_MOCK_AUTH=false

# Secret configured on the GitHub webhook (Settings > Webhooks) used to
# verify the X-Hub-Signature-256 header. Required for /webhook/github to
# accept any payload; leaving it unset makes that endpoint refuse all events.
GITHUB_WEBHOOK_SECRET=

# Comma-separated list of origins allowed to call this API (CORS). Defaults
# to the published Chrome Web Store ID + a known unpacked dev install ID +
# localhost:3000 if unset. Chrome mints a NEW id for every unpacked install
# path ("Load unpacked" derives it from the folder's absolute path) - if you
# load unpacked from a different path, you'll need to add that id here too.
ALLOWED_ORIGINS=chrome-extension://jfngcklfbiljgpoeehlkpkackahgopoc,chrome-extension://gimimplokapoleofedgmdnghpcdhkmhm,http://localhost:3000

# LLM providers (BYOK keys from the extension's Settings panel are used
# preferentially; these act as the shared/global fallback pool).
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Used server-side for fetching PR data/comments when a user hasn't
# supplied their own GitHub token.
GITHUB_TOKEN=

CHROMA_DB_DIR=./chroma_db
